# HTTP Server
PORT=8080
ENVIRONMENT=development

# AWS Configuration
AWS_REGION=us-east-1
SQS_QUEUE_URL=http://localhost:4566/000000000000/experience-hub-tickets
DYNAMODB_TABLE_NAME=experience-hub-audit-logs

# PostgreSQL (Amazon RDS)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/experience_hub?sslmode=disable

# Redis (Amazon ElastiCache)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Worker Pool
WORKER_CONCURRENCY=5
